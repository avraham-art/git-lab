pipeline {
    agent any

    environment {
        IMAGE = "avrahamfeelalive/jenkins-demo"
        TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Build Docker Image') {
            steps {
                dir('jenkins-docker-demo') {
                    sh 'docker build -t $IMAGE:$TAG .'
                }
            }
        }

        stage('Scan Image') {
            steps {
                sh 'trivy image --exit-code 1 --severity HIGH,CRITICAL $IMAGE:$TAG'
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credential',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_TOKEN'
                )]) {
                    sh '''
                        echo "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push "$IMAGE:$TAG"
                    '''
                }
            }
        }

        stage('Record Current Version') {
            steps {
                script {
                    env.PREVIOUS_IMAGE = sh(
                        script: "docker inspect -f '{{.Config.Image}}' jenkins-demo-prod 2>/dev/null || true",
                        returnStdout: true
                    ).trim()

                    echo "Previous image: ${env.PREVIOUS_IMAGE}"
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f jenkins-demo-prod || true
                    docker pull $IMAGE:$TAG
                    docker run -d \
                        --name jenkins-demo-prod \
                        -p 8082:80 \
                        $IMAGE:$TAG
                '''
            }
        }

        stage('Verify') {
            steps {
                sh 'curl -fsS http://localhost:8082'
            }
        }
    }

    post {
        failure {
            script {
                if (env.PREVIOUS_IMAGE?.trim()) {
                    echo "Deployment failed. Rolling back to ${env.PREVIOUS_IMAGE}"

                    sh '''
                        docker rm -f jenkins-demo-prod || true
                        docker pull "$PREVIOUS_IMAGE"
                        docker run -d \
                            --name jenkins-demo-prod \
                            -p 8082:80 \
                            "$PREVIOUS_IMAGE"
                    '''
                } else {
                    echo "No previous image found. Rollback skipped."
                }
            }
        }

        always {
            sh 'docker logout || true'
        }
    }
}
